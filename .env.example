# Получите API_ID и API_HASH на https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Генерируется автоматически скриптом `python auth.py`
TELEGRAM_SESSION_STRING=

# Опционально: имя локального .session файла (если TELEGRAM_SESSION_STRING пуст)
TELEGRAM_SESSION_NAME=telegram_user

# Опционально: максимальное время автоматического ожидания при FloodWaitError (в секундах)
TELEGRAM_MAX_FLOOD_WAIT_SLEEP=15
